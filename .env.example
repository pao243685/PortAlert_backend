POSTGRES_USER=portalert
POSTGRES_PASSWORD=
POSTGRES_DB=portalert
DATABASE_URL=postgresql+psycopg2://portalert:@localhost:5433/portalert
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=
VIRUSTOTAL_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Instaladores: donde publicas los binarios del agente y la URL publica de esta API
PUBLIC_API_URL=
AGENT_DOWNLOAD_URL_LINUX=
AGENT_DOWNLOAD_URL_WINDOWS=
AGENT_SHA256_LINUX=
AGENT_SHA256_WINDOWS=

# --- seguridad ---
# production: apaga /docs, activa HSTS y CSP estricta
APP_ENV=development
# Hosts con los que se acepta tráfico (separados por coma). Vacío = cualquiera. Ej: api.tudominio.com
ALLOWED_HOSTS=
# Detrás de un proxy/CDN: de dónde sacar la IP real del cliente (para los límites de peticiones).
# Cloudflare: CF-Connecting-IP · Fly.io: Fly-Client-IP · otro proxy: TRUSTED_PROXY_HOPS=1 (usa X-Forwarded-For)
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=0
RATE_LIMIT_ENABLED=1
